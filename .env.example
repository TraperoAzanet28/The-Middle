# Environment variables for The Middle Panel's /api backend.
#
# Copy this file to `.env` (or `.env.local`) for local development and fill
# in real values there. NEVER commit a file containing real secrets — `.env*`
# is excluded via .gitignore.
#
# None of these are read by the current Phase 0 code. They are documented
# here so Phase 1 (real model integration) has a known, reviewed contract to
# implement against.

# ---- Phase 1: Model provider credentials (not yet used) -------------------

# API key for Anthropic's Claude API. Required once /api/_lib/handler.ts is
# updated to call a real model instead of returning the stub response.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the default model name used for character responses.
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Phase 1: Durable rate limiting (not yet used) -------------------------

# If/when the in-memory rate limiter in api/_lib/rateLimit.ts is replaced
# with Upstash Redis (recommended for Vercel serverless):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- CORS configuration (used today) ---------------------------------------

# Comma-separated list of additional allowed origins (e.g. preview deploy
# URLs) beyond the deployment's own origin. Optional.
# ALLOWED_ORIGINS=https://preview-branch.vercel.app
